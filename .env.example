# Copy to backend/.env (or export in your shell). Never commit real values.

# Where FinV keeps its database, encrypted documents and storage key (local machine).
FINV_DATA_DIR=./data
# Default: SQLite inside FINV_DATA_DIR. For a multi-user server use PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://finv:CHANGE_ME@localhost:5432/finv
# DATABASE_URL=

# Key used to encrypt uploaded documents at rest (Fernet, 32 url-safe base64 bytes).
# If unset, FinV generates one into FINV_DATA_DIR/storage.key (mode 0600) on first upload.
# FINV_STORAGE_KEY=

FINV_MAX_UPLOAD_MB=20
FINV_SESSION_HOURS=12
# Set to true when served over HTTPS (marks the session cookie Secure).
FINV_COOKIE_SECURE=false

# ---- Optional AI assistance (off by default) ----
# none | gemini | anthropic | openai. There is no automatic fallback between providers.
#   gemini    = Google Gemini Flash, free tier (GEMINI_API_KEY; model FINV_GEMINI_MODEL, default gemini-3.5-flash).
#   anthropic = Claude (default model claude-opus-5-5); openai requires FINV_AI_MODEL.
FINV_AI_PROVIDER=none
# FINV_AI_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
FINV_AI_TIMEOUT=30
FINV_AI_MAX_RETRIES=2
FINV_AI_MAX_CALLS_PER_MINUTE=20
# Even with a provider configured, each company must opt in (Settings > Privacy & AI).
# Privacy mode for NEW companies: local_only (default, AI off) | pseudonymized_ai | cloud_ai (AI on for chat and
# suggestions without a per-company click). Admins can still change it per company.
# FINV_DEFAULT_PRIVACY_MODE=local_only

# TallyPrime HTTP server (F1 Help > Settings > Connectivity). Only local/LAN addresses are accepted.
FINV_TALLY_URL=http://127.0.0.1:9000

# Assistant voice input: open-source Whisper on this machine (pip install -r requirements-voice.txt).
# tiny | base | small ... (larger = more accurate, slower). Weights download once into FINV_DATA_DIR/models.
FINV_WHISPER_MODEL=base

# Understanding free-form chat messages: gemini (default) | none. Only the typed text, with names, identifiers and
# amounts removed, is sent; the model returns one action that FinV runs locally. Works without any company setting.
FINV_INTENT_PROVIDER=gemini

# Full chat model (sees client data through tools; only for companies whose admin chose "Cloud AI"): gemini | groq | xai. All are cloud services: chat context (client data) is sent to
# the provider, so the assistant only uses them for companies whose admin chose "Cloud AI" in Settings > Privacy & AI.
FINV_CHAT_PROVIDER=gemini
# GROQ_API_KEY=            # free key: https://console.groq.com/keys
# FINV_GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=          # free key: https://aistudio.google.com/apikey
# FINV_GEMINI_MODEL=gemini-3.5-flash
# XAI_API_KEY=             # https://console.x.ai
# FINV_XAI_MODEL=

# Local OCR binary for images and scanned PDFs.
FINV_TESSERACT=tesseract
